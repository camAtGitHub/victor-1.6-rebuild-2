{
  "behaviorID": "SingletonPounceDispatcher",
  "behaviorClass": "DispatcherStrictPriority",
  "interruptActiveBehavior": true,
  "actAsSelector": true,

  "wantsToBeActivatedCondition": {
    "conditionType": "Compound",
    "or": [
      {
        "conditionType": "MotionDetected",
        "motionArea": "Left",
        "motionLevel": "High"
      },
      {
        "conditionType": "MotionDetected",
        "motionArea": "Right",
        "motionLevel": "High"
      }
    ]
  },

  "wantsToCancelSelfCondition": {
    "conditionType": "TimerInRange",
    "begin_s": 8.0
  },

  "behaviors": [
    "SingletonPounceTurnLeft",
    "SingletonPounceTurnRight"
  ]
}
